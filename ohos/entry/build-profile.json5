      // flutter build hap --flavor <product> 依赖这个对应关系。
      // 注意：`default` 对应调试包（DevEco 直接 Run 的默认 product），
      // 正式版走 `--flavor release`。
      "name": "release",
      "runtimeOS": "HarmonyOS"
    },
    {
      "name": "beta",
      "runtimeOS": "HarmonyOS"
    },
    {
      "name": "ohosTest",
    }
  ]
}